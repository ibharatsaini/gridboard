{
  "name": "@gridboard/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "tsup",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate --config ../../prisma.config.ts",
    "db:migrate": "prisma migrate deploy --config ../../prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config ../../prisma.config.ts",
    "db:seed": "tsx --env-file-if-exists=../../.env src/db/seed.ts",
    "postinstall": "prisma generate --config ../../prisma.config.ts",
    "db:reset": "prisma migrate reset --force --config ../../prisma.config.ts && pnpm db:seed",
    "db:status": "prisma migrate status --config ../../prisma.config.ts"
  },
  "dependencies": {
    "@gridboard/shared": "workspace:*",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@socket.io/redis-adapter": "8.3.0",
    "@upstash/ratelimit": "2.2.0",
    "@upstash/redis": "1.39.0",
    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "socket.io": "4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@gridboard/config": "workspace:*",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.5",
    "@types/pg": "8.23.1",
    "pino-pretty": "13.1.3",
    "prisma": "7.10.0",
    "tsup": "8.5.1",
    "tsx": "4.23.15",
    "typescript": "6.0.3"
  }
}
