# ---------- Runtime ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info

# ---------- URLs ----------
# Origin of the web app (Vite, port 3000). Used for CORS and the Origin checks on the API and the WebSocket. It must match the browser's origin
# exactly (scheme + host + port, no trailing slash). It may be on a different domain from the API.
WEB_URL=http://localhost:3000
API_URL=http://localhost:4000

# ---------- PostgreSQL (docker compose up -d) ----------
DATABASE_URL=postgresql://gridboard:gridboard@localhost:5432/gridboard

# ---------- Security ----------
# Authentication is a random bearer token (stored hashed), not a cookie, so there is no secret to configure
# and web and API can live on completely different domains.
# Number of reverse proxies in front of the API (so rate limits see real client IPs).
TRUST_PROXY=0

# ---------- Upstash Redis (mandatory) ----------
# Upstash console -> your database -> "REST API" section.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Same console, "Connect" -> TCP/ioredis. Starts with rediss://  Required for Socket.IO Pub/Sub:
# the REST API cannot SUBSCRIBE, so the adapter needs a real TCP/TLS connection.
UPSTASH_REDIS_URL=

# ---------- Web ----------
# The browser app is configured separately, in apps/web/.env (see apps/web/.env.example):
# VITE_API_URL, only needed when the API is not on http://localhost:4000. Do not put it here:
# this file holds server secrets and its NODE_ENV must not reach the Vite build.

